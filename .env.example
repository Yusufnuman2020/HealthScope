# HealthScope yapılandırma örneği.
# Bu dosyayı `.env` olarak kopyalayın ve kendi makinenize göre düzenleyin.
# `.env` git'e girmez (.gitignore'da).

# ── Backend (config.py tarafından okunur) ─────────────────────────────────

# Fine-tune edilmiş BERTurk modeli. HuggingFace kimliği ya da yerel dizin
# olabilir; transformers ilk açılışta indirip önbelleğe alır.
# Tanımlanmazsa temel model (dbmdz/bert-base-turkish-cased) kullanılır ve
# sunucu çalışmaya devam eder — yalnızca çıkarım kalitesi düşer.
HEALTHSCOPE_MODEL_PATH=Ruhadam2020/checkpoint-85239

# Tokenizer / yedek model (HuggingFace Hub kimliği).
# HEALTHSCOPE_BASE_MODEL=dbmdz/bert-base-turkish-cased

# Poppler `bin` dizini (PDF -> görsel dönüşümü için).
# Boş bırakılırsa proje içindeki POPPLER/ klasöründe otomatik aranır.
# HEALTHSCOPE_POPPLER_PATH=C:\...\healthscope\POPPLER\Release-26.02.0-0\poppler-26.02.0\Library\bin

# Klinik veritabanı yolu (varsayılan: proje kökündeki database.json).
# HEALTHSCOPE_DATABASE_PATH=

# Sunucu adresi.
HEALTHSCOPE_HOST=127.0.0.1
HEALTHSCOPE_PORT=8000

# CORS: virgülle ayrılmış izinli origin listesi.
# Sağlık verisi işlendiği için joker (*) KULLANMAYIN.
HEALTHSCOPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Yükleme sınırları (DoS koruması).
HEALTHSCOPE_MAX_UPLOAD_MB=10
HEALTHSCOPE_MAX_PDF_PAGES=15

# 1 ise modeller sunucu açılırken arka planda ısıtılır.
HEALTHSCOPE_EAGER_LOAD=1


# ── Hibrit üretken katman (opsiyonel) ─────────────────────────────────────
# Kural motorunun çıkardığı klinik öznitelikler üzerinde akıl yürüten model.
# Kapalıyken sistem yalnızca BERTurk fill-mask kullanır (varsayılan davranış).
#
#   none              kapalı
#   local             yerel model (transformers) — GPU önerilir
#   openai-compatible Ollama / LM Studio / bulut uç noktası
HEALTHSCOPE_LLM_PROVIDER=none

# Yerel sağlayıcı için HuggingFace kimliği. Qwen2.5-3B fp16 olarak ~5.8 GB
# VRAM ister; 8 GB'lık bir RTX 4060'ta vaka başına ~14 sn ölçüldü.
# HEALTHSCOPE_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# 4-bit niceleme (bitsandbytes gerekir). VRAM azsa açın; yoksa fp16'ya düşer.
# HEALTHSCOPE_LLM_QUANTIZE=1

# openai-compatible sağlayıcı için:
# HEALTHSCOPE_LLM_BASE_URL=http://localhost:11434/v1
# HEALTHSCOPE_LLM_API_KEY=

# HEALTHSCOPE_LLM_MAX_NEW_TOKENS=320
# HEALTHSCOPE_LLM_TIMEOUT=120


# ── Frontend (Next.js — build sırasında gömülür) ──────────────────────────
# Analiz sayfasının konuşacağı backend adresi.
# GitHub Pages gibi statik bir yayında backend'e erişilemiyorsa arayüz
# otomatik olarak "çevrimdışı" uyarısı gösterir.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
